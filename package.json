{
  "name": "my-spot-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run && playwright test && playwright test --config playwright.pwa.config.js && playwright test --config playwright.private.config.js",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config playwright.pwa.config.js",
    "test:private": "playwright test --config playwright.private.config.js",
    "verify:dist": "node scripts/verify-dist.js",
    "create:offline-key": "node scripts/create-offline-key.js",
    "check:private": "node scripts/check-private-config.js",
    "dev:private": "wrangler dev --config wrangler.local.jsonc --local",
    "deploy:private": "npm run check:private && wrangler deploy --config wrangler.local.jsonc",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "dexie": "4.4.7",
    "jose": "6.2.14",
    "leaflet": "1.9.4",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "fake-indexeddb": "6.2.7",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  }
}
