{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-spot-map-private",
  "main": "server/index.js",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "my-spot-map-private", "database_id": "設定時に置換", "migrations_dir": "server/migrations" }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": false },
  "vars": { "APP_ORIGIN": "設定時に置換" }
}
